<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never back up or transfer the encrypted token, the Tink keyset or push keys. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/secure.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/secure.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
